+package game
+
+import (
+	"encoding/json"
+	"sort"
+)
+
+func majorActive(s *State) bool {
+	return s.Progress["major_pending"] == 1 || s.Battle != nil && s.Battle.InvasionType == "Major"
+}
+func addNotoriety(s *State) {
+	if !majorActive(s) {
+		s.Progress["notoriety"] = min(100, s.Progress["notoriety"]+10)
+	}
+}
+func majorTeam(s *State) (int, Row) {
+	id := 0
+	var result Row
+	for _, team := range tables["TeamConfig"] {
+		if team.s("TeamType") == "Major" && int(team.n("StageID")) == s.Progress["current_stage_id"] {
+			if result != nil {
+				return 0, nil
+			}
+			id, result = int(team.n("ID")), team
+		}
+	}
+	return id, result
+}
+func majorRoute(s *State) []int {
+	out := []int{}
+	for _, r := range s.Rooms {
+		if r.Level > 0 {
+			out = append(out, r.Index)
+		}
+	}
+	sort.Ints(out)
+	return out
+}
+func (e *Engine) majorAction(d *Document, action string, a arguments, now int64) (any, *BusinessError) {
+	s := d.State
+	teamID, team := majorTeam(s)
+	if action == "battle-major-checkpoint" {
+		return e.majorCheckpoint(d, a)
+	}
+	if team == nil || a.Team != teamID {
+		return nil, fail("CONFIG_MISMATCH")
+	}
+	if s.Battle != nil {
+		return nil, fail("UNIT_BUSY")
+	}
+	if action == "battle-major-prepare" {
+		if s.Progress["major_pending"] != 1 && s.Progress["notoriety"] < 100 {
+			return nil, fail("CONDITION_NOT_MET")
+		}
+		s.Progress["notoriety"] = 0
+		s.Progress["major_pending"] = 1
+		s.Progress["major_team_id"] = teamID
+		return Object{"team_id": teamID, "phase": "preparing"}, nil
+	}
+	if action != "battle-major-start" || s.Progress["major_pending"] != 1 || s.Progress["major_team_id"] != teamID {
+		return nil, fail("CONDITION_NOT_MET")
+	}
+	members, ok := parsePairs(team.s("Members"))
+	route := majorRoute(s)
+	if !ok || len(route) == 0 {
+		return nil, fail("CONFIG_MISMATCH")
+	}
+	b := &Battle{ID: uid(), Encounter: uid(), Status: "active", Started: now, Expires: MaxSafe,
+		InvasionType: "Major", CurrentRoom: route[0], TeamID: teamID, Members: team.s("Members"),
+		Units: []Unit{}, Events: []Event{}, EnemySlots: []EnemySlot{}}
+	d.Snapshots = map[string]Object{"_battle": {"room_index": route[0]}}
+	d.Loot = []Loot{}
+	d.Losses = map[string]int64{"soldier": 0, "archer": 0, "mage": 0}
+	add := func(config int, side, kind string, troop *int, source *int, level int, cfg Row) {
+		stats := Attributes{}
+		for _, key := range attrs {
+			stats[key] = cfg.n(key) + cfg.n(key+"up")*int64(level)
+			if side == "own" && kind == "lord" && config == s.Feed.Model {
+				stats[key] = s.Feed.Attributes[key]
+			}
+		}
+		u := Unit{ID: uid(), Config: config, Side: side, Kind: kind, Troop: troop, Room: source, Alive: true, Life: 1,
+			HP: stats["HP"], MP: stats["MP"], Attributes: stats}
+		b.Units = append(b.Units, u)
+		d.Snapshots[u.ID] = Object{"attributes": stats, "allow_enemy_escape": false, "revival_limit": 0, "revivals_used": 0}
+		if side == "enemy" {
+			d.Snapshots[u.ID]["drop"] = row("DropConfig", int(cfg.n("Dropid")))
+		}
+	}
+	for _, pair := range members {
+		cfg := row("Heros", pair[0])
+		if cfg == nil || row("DropConfig", int(cfg.n("Dropid"))) == nil {
+			return nil, fail("CONFIG_MISMATCH")
+		}
+		slot := EnemySlot{Position: len(b.EnemySlots) + 1, HeroID: pair[0], Count: pair[1], UnitIDs: []string{}}
+		for n := 0; n < pair[1]; n++ {
+			add(pair[0]+1000, "enemy", "enemy_hero", nil, nil, int(team.n("Level")), cfg)
+			slot.UnitIDs = append(slot.UnitIDs, b.Units[len(b.Units)-1].ID)
+		}
+		b.EnemySlots = append(b.EnemySlots, slot)
+	}
+	for _, index := range route {
+		rm := room(s, index)
+		if rm.Type != 10 && rm.Type != 12 && rm.Type != 15 {
+			continue
+		}
+		if rm.Guard > 0 {
+			m := monster(s, rm.Guard)
+			cfg := row("Monsters", rm.Guard)
+			if m == nil || m.Level < 1 || cfg == nil {
+				return nil, fail("CONFIG_MISMATCH")
+			}
+			source := index
+			add(m.ID, "own", "lord", nil, &source, m.Level, cfg)
+		}
+		for t := 1; t <= 3; t++ {
+			tr := s.Troops[troopNames[t]]
+			id := troopID(t, tr.Level)
+			cfg := row("Monsters", id)
+			if cfg == nil {
+				return nil, fail("CONFIG_MISMATCH")
+			}
+			for n := int64(0); n < *roomCount(rm, t); n++ {
+				source, troop := index, t
+				add(id, "own", "soldier", &troop, &source, tr.Level, cfg)
+			}
+		}
+	}
+	s.Battle = b
+	return Object{"battle": b}, nil
+}
+
+func (e *Engine) majorCheckpoint(d *Document, a arguments) (any, *BusinessError) {
+	b := d.State.Battle
+	if b == nil || b.ID != a.Battle || b.InvasionType != "Major" {
+		return nil, fail("BATTLE_NOT_FOUND")
+	}
+	if a.Room == nil || a.LastSeq != b.Seq {
+		return nil, fail("INVALID_BATTLE_EVENT")
+	}
+	if a.Phase != "entering" && a.Phase != "active" && a.Phase != "leaving" {
+		return nil, fail("INVALID_ARGUMENT")
+	}
+	route := majorRoute(d.State)
+	current, next := -1, -1
+	for i, index := range route {
+		if index == b.CurrentRoom {
+			current = i
+		}
+		if index == *a.Room {
+			next = i
+		}
+	}
+	if current < 0 || next < current || next > current+1 {
+		return nil, fail("INVALID_BATTLE_EVENT")
+	}
+	if next > current || a.Phase == "leaving" {
+		for _, u := range b.Units {
+			if u.Side == "own" && u.Alive && u.Room != nil && *u.Room == b.CurrentRoom {
+				return nil, fail("RESULT_MISMATCH")
+			}
+		}
+	}
+	seen := map[string]bool{}
+	for _, v := range a.CheckpointUnits {
+		u := findUnit(b, v.ID)
+		if u == nil || !u.Alive || seen[v.ID] || v.HP <= 0 || v.MP < 0 || v.HP > u.Attributes["HP"] || v.MP > u.Attributes["MP"] {
+			return nil, fail("INVALID_BATTLE_EVENT")
+		}
+		if u.Side == "enemy" && !enemyDeployed(b, u.ID) {
+			return nil, fail("INVALID_BATTLE_EVENT")
+		}
+		seen[v.ID] = true
+		u.HP = v.HP
+		u.MP = v.MP
+	}
+	b.CurrentRoom = *a.Room
+	b.Checkpoint = &MajorCheckpoint{Room: *a.Room, Phase: a.Phase, Units: a.CheckpointUnits}
+	return Object{"checkpoint": b.Checkpoint}, nil
+}
+
+func (e *Engine) closeMajorBattle(d *Document, outcome string) (any, *BusinessError) {
+	b := d.State.Battle
+	var loot *Loot
+	if outcome == "win" {
+		drop := row("DropConfig", int(row("TeamConfig", b.TeamID).n("DropID")))
+		if drop == nil {
+			return nil, fail("CONFIG_MISMATCH")
+		}
+		loot = &Loot{ID: uid(), Resources: Amounts{"coin": drop.n("Coin"), "food": drop.n("Food"), "soul": drop.n("Soul")}, Items: []Item{}}
+		if err := grant(d.State, loot.Resources); err != nil {
+			return nil, err
+		}
+		pairs, ok := parsePairs(drop.s("DropContent"))
+		if !ok {
+			return nil, fail("CONFIG_MISMATCH")
+		}
+		for _, pair := range pairs {
+			if err := addItem(d.State, pair[0], int64(pair[1])); err != nil {
+				return nil, err
+			}
+			loot.Items = append(loot.Items, Item{pair[0], int64(pair[1])})
+		}
+		d.State.Progress["current_stage_id"]++
+	} else {
+		for _, key := range []string{"coin", "wood", "metal", "crystal", "food", "soul"} {
+			d.State.Resources[key] -= d.State.Resources[key] / 10
+		}
+	}
+	d.State.Progress["major_pending"] = 0
+	d.State.Progress["notoriety"] = 0
+	delete(d.State.Progress, "major_team_id")
+	for i := range d.State.Rooms {
+		d.State.Rooms[i].Updated = e.Now().UnixMilli()
+	}
+	result := e.closeBattle(d, outcome, "elimination").(Object)
+	if loot != nil {
+		result["loot"] = loot
+	}
+	d.LastResult, _ = json.Marshal(result)
+	return result, nil
+}
