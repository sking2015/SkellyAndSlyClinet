@@ -0,0 +1,155 @@
+package game
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+	"time"
+)
+
+func prepareMajor(t *testing.T) *fixture {
+	t.Helper()
+	f := setup(t)
+	rich(f)
+	f.store.doc.State.Progress["notoriety"] = 100
+	wantCode(t, f.call(t, "battle-major-prepare", Object{"team_id": 10}), "OK")
+	return f
+}
+func startMajor(t *testing.T) *fixture {
+	t.Helper()
+	f := prepareMajor(t)
+	wantCode(t, f.call(t, "battle-major-start", Object{"team_id": 10}), "OK")
+	return f
+}
+func TestMajorPreparationAndLocks(t *testing.T) {
+	f := prepareMajor(t)
+	if f.store.doc.State.Progress["notoriety"] != 0 {
+		t.Fatal("trigger must reset notoriety")
+	}
+	stock := room(f.store.doc.State, 5).Storage
+	f.now = f.now.Add(time.Hour)
+	wantCode(t, f.call(t, "state-sync", Object{}), "OK")
+	if room(f.store.doc.State, 5).Storage != stock {
+		t.Fatal("production continued during preparation")
+	}
+	wantCode(t, f.call(t, "troop-train", Object{"room_index": 2, "troop_type": 1, "count": 1}), "OK")
+	if f.store.doc.State.Progress["notoriety"] != 0 {
+		t.Fatal("preparation actions should not build the next invasion")
+	}
+	wantCode(t, f.call(t, "room-gather", Object{"room_index": 5, "gather_session_id": uid(), "phase": "start"}), "UNIT_BUSY")
+	wantCode(t, f.call(t, "battle-major-start", Object{"team_id": 10}), "OK")
+	for _, action := range []string{"troop-train", "room-lv-up", "monster-recruit", "feed-submit"} {
+		data := Object{"room_index": 2, "troop_type": 1, "count": 1, "monster_id": 1, "item_id": 1001}
+		wantCode(t, f.call(t, action, data), "MAJOR_BATTLE_LOCKED")
+	}
+	f.now = f.now.Add(24 * time.Hour)
+	wantCode(t, f.call(t, "state-sync", Object{}), "OK")
+	if f.store.doc.State.Battle == nil {
+		t.Fatal("resumable major battle must not time out as a minor battle")
+	}
+}
+func TestMajorGatherAlreadyInProgress(t *testing.T) {
+	f := setup(t)
+	rich(f)
+	session := uid()
+	wantCode(t, f.call(t, "room-gather", Object{"room_index": 5, "gather_session_id": session, "phase": "start"}), "OK")
+	f.store.doc.State.Progress["notoriety"] = 100
+	wantCode(t, f.call(t, "battle-major-prepare", Object{"team_id": 10}), "OK")
+	wantCode(t, f.call(t, "battle-major-start", Object{"team_id": 10}), "OK")
+	wantCode(t, f.call(t, "room-gather", Object{"room_index": 5, "gather_session_id": session, "phase": "finish"}), "OK")
+}
+func TestMajorNotorietyBatchAndReplay(t *testing.T) {
+	f := setup(t)
+	rich(f)
+	raw, _ := json.Marshal(Object{"room_index": 2, "troop_type": 1, "count": 3})
+	req := Request{Player: "p", ID: uid(), Version: f.version, Action: "troop-train", Data: string(raw)}
+	reply, err := f.e.Execute(context.Background(), req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	wantCode(t, reply, "OK")
+	reply, err = f.e.Execute(context.Background(), req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	wantCode(t, reply, "OK")
+	if f.store.doc.State.Progress["notoriety"] != 10 {
+		t.Fatal("one batch/request replay must only add ten")
+	}
+}
+func TestMajorVictoryRewardAndFailurePenalty(t *testing.T) {
+	for _, win := range []bool{true, false} {
+		f := startMajor(t)
+		b := f.store.doc.State.Battle
+		for i := range b.Units {
+			if win && b.Units[i].Side == "enemy" || !win && b.Units[i].Side == "own" {
+				b.Units[i].Alive = false
+			}
+		}
+		before := clone(f.store.doc.State.Resources)
+		outcome := "lose"
+		if win {
+			outcome = "win"
+		}
+		data := Object{"battle_id": b.ID, "result": outcome, "duration_ms": 0, "last_event_seq": 0, "termination_reason": "elimination"}
+		raw, _ := json.Marshal(data)
+		req := Request{Player: "p", ID: uid(), Version: f.version, Action: "battle-end", Data: string(raw)}
+		response, err := f.e.Execute(context.Background(), req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		wantCode(t, response, "OK")
+		again, err := f.e.Execute(context.Background(), req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		wantCode(t, again, "OK")
+		s := f.store.doc.State
+		if s.Battle != nil || majorActive(s) {
+			t.Fatal("major state not released")
+		}
+		if win {
+			if s.Progress["current_stage_id"] != 2 || s.Resources["coin"] != before["coin"]+500 {
+				t.Fatal("victory did not grant one reward/advance stage")
+			}
+		} else {
+			for key, amount := range before {
+				if s.Resources[key] != amount-amount/10 {
+					t.Fatalf("incorrect penalty for %s", key)
+				}
+			}
+			if s.Progress["current_stage_id"] != 1 {
+				t.Fatal("failure advanced stage")
+			}
+		}
+	}
+}
+func TestMajorCheckpointRecoveryAndFloorValidation(t *testing.T) {
+	f := prepareMajor(t)
+	s := f.store.doc.State
+	s.Troops["soldier"].Available = 1
+	room(s, 0).Soldier = 1
+	wantCode(t, f.call(t, "battle-major-start", Object{"team_id": 10}), "OK")
+	b := f.store.doc.State.Battle
+	wantCode(t, f.call(t, "battle-major-checkpoint", Object{"battle_id": b.ID, "room_index": 1, "phase": "entering", "last_event_seq": 0, "units": []CheckpointUnit{}}), "RESULT_MISMATCH")
+	b = f.store.doc.State.Battle
+	var enemy *Unit
+	for i := range b.Units {
+		u := &b.Units[i]
+		if u.Side == "enemy" && enemy == nil {
+			enemy = u
+		}
+		if u.Side == "own" {
+			u.Alive = false
+		}
+	}
+	wantCode(t, f.call(t, "battle-major-checkpoint", Object{"battle_id": b.ID, "room_index": 1, "phase": "entering", "last_event_seq": 0, "units": []CheckpointUnit{{ID: enemy.ID, HP: 1, MP: 0}}}), "OK")
+	reply, err := f.e.Login(context.Background(), "p", uid(), "token")
+	if err != nil {
+		t.Fatal(err)
+	}
+	restored := reply.Data.State.Battle
+	if restored.CurrentRoom != 1 || restored.Checkpoint == nil || findUnit(restored, enemy.ID).HP != 1 || findUnit(restored, enemy.ID).MP != 0 {
+		t.Fatal("checkpoint did not survive login")
+	}
+}
